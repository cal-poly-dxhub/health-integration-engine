# AWS Configuration
VITE_AWS_REGION=us-east-1
VITE_API_GATEWAY_URL=https://your-api-gateway-url

# Cognito Configuration (populated after CDK deployment)
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_USER_POOL_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
VITE_COGNITO_IDENTITY_POOL_ID=us-east-1:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VITE_COGNITO_DOMAIN=workflow-builder-dev.auth.us-east-1.amazoncognito.com

# Development Configuration
VITE_NODE_ENV=development

# Feature Flags
VITE_ENABLE_DEBUG=true
VITE_ENABLE_MOCK_DATA=false

# WebSocket Configuration
VITE_WEBSOCKET_URL=wss://your-websocket-api-url