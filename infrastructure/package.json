{
  "name": "aws-stepfunctions-workflow-builder-infrastructure",
  "version": "1.0.0",
  "description": "CDK Infrastructure for AWS Step Functions Workflow Builder",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "deploy": "cdk deploy WorkflowBuilderStack",
    "deploy:dev": "cross-env NODE_ENV=development cdk deploy WorkflowBuilderStack",
    "deploy:staging": "cross-env NODE_ENV=staging cdk deploy WorkflowBuilderStack",
    "deploy:prod": "cross-env NODE_ENV=production cdk deploy WorkflowBuilderStack",
    "deploy:frontend": "cdk deploy --app \"npx ts-node bin/frontend-app.ts\"",
    "deploy:frontend:dev": "cross-env NODE_ENV=development cdk deploy --app \"npx ts-node bin/frontend-app.ts\"",
    "deploy:frontend:prod": "cross-env NODE_ENV=production cdk deploy --app \"npx ts-node bin/frontend-app.ts\"",
    "check-s3": "npx ts-node scripts/check-s3-bucket.ts",
    "deploy-files": "npx ts-node scripts/deploy-frontend-files.ts",
    "invalidate-cache": "npx ts-node scripts/invalidate-cloudfront.ts",
    "rebuild-deploy": "npx ts-node scripts/rebuild-and-deploy.ts",
    "destroy": "cdk destroy WorkflowBuilderStack",
    "destroy:frontend": "cdk destroy --app \"npx ts-node bin/frontend-app.ts\"",
    "diff": "cdk diff WorkflowBuilderStack",
    "diff:frontend": "cdk diff --app \"npx ts-node bin/frontend-app.ts\"",
    "synth": "cdk synth WorkflowBuilderStack",
    "synth:frontend": "cdk synth --app \"npx ts-node bin/frontend-app.ts\"",
    "bootstrap": "cdk bootstrap",
    "lint": "eslint lib --ext .ts",
    "lint:fix": "eslint lib --ext .ts --fix",
    "format": "prettier --write \"lib/**/*.ts\"",
    "format:check": "prettier --check \"lib/**/*.ts\""
  },
  "dependencies": {
    "@aws-sdk/client-cloudformation": "^3.0.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "aws-cdk-lib": "^2.70.0",
    "chalk": "^4.1.2",
    "constructs": "^10.1.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^18.15.3",
    "@typescript-eslint/eslint-plugin": "^5.57.1",
    "@typescript-eslint/parser": "^5.57.1",
    "aws-cdk": "^2.70.0",
    "cross-env": "^7.0.3",
    "esbuild": "^0.19.12",
    "eslint": "^8.38.0",
    "jest": "^29.5.0",
    "prettier": "^2.8.7",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.2"
  }
}
