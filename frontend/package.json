{
  "name": "aws-stepfunctions-workflow-builder-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:with-types": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "type-check": "tsc --noEmit",
    "setup-env": "node scripts/setup-env.cjs",
    "test-build": "node scripts/test-build.cjs",
    "deploy-build": "node scripts/deploy-build.cjs",
    "deploy:s3": "node scripts/deploy-build.cjs && node scripts/deploy-s3-cloudfront.cjs",
    "deploy:s3-quick": "node scripts/setup-env.cjs && node scripts/deploy-s3-cloudfront.cjs",
    "deploy:s3-simple": "node scripts/deploy-build.cjs && node scripts/deploy-s3-simple.cjs",
    "deploy:s3-website": "node scripts/deploy-build.cjs && node scripts/deploy-s3-website.cjs",
    "deploy:s3-private": "node scripts/deploy-build.cjs && node scripts/deploy-s3-private-cloudfront.cjs",
    "fix-cloudfront": "node scripts/fix-cloudfront.cjs",
    "deploy:frontend": "tsx scripts/deployment/deploy-frontend.ts",
    "deploy:frontend:dev": "tsx scripts/deployment/deploy-frontend.ts --env=development",
    "deploy:frontend:staging": "tsx scripts/deployment/deploy-frontend.ts --env=staging",
    "deploy:frontend:prod": "tsx scripts/deployment/deploy-frontend.ts --env=production",
    "deploy:production": "tsx scripts/deployment/deploy-frontend.ts --env=production --skip-validation --auto-approve --skip-linting --verbose",
    "deploy:direct": "tsx scripts/deployment/deploy-frontend-direct.ts",
    "deploy:direct:prod": "tsx scripts/deployment/deploy-frontend-direct.ts --env=production",
    "deploy:frontend:rollback": "tsx scripts/deployment/rollback-frontend.ts",
    "deploy:status": "tsx scripts/deployment/deployment-status.ts",
    "deploy:validate": "tsx scripts/deployment/validate-deployment.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.913.0",
    "@aws-sdk/credential-providers": "^3.913.0",
    "@monaco-editor/react": "^4.4.6",
    "@reduxjs/toolkit": "^1.9.3",
    "axios": "1.6.8",
    "buffer": "^4.9.2",
    "cross-fetch": "^4.1.0",
    "process": "^0.11.10",
    "react": "^18.2.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^18.2.0",
    "react-redux": "^8.0.5",
    "react-router-dom": "^6.8.1",
    "stream-browserify": "^3.0.0",
    "util": "^0.12.5",
    "whatwg-fetch": "^3.6.20",
    "zod": "^3.20.6"
  },
  "devDependencies": {
    "@esbuild-plugins/node-globals-polyfill": "^0.2.3",
    "@esbuild-plugins/node-modules-polyfill": "^0.2.2",
    "@types/node": "^24.8.1",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@typescript-eslint/eslint-plugin": "^5.57.1",
    "@typescript-eslint/parser": "^5.57.1",
    "@vitejs/plugin-react": "^4.0.0",
    "chalk": "^5.3.0",
    "commander": "^11.0.0",
    "eslint": "^8.38.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.3.4",
    "ora": "^7.0.1",
    "prettier": "^2.8.7",
    "terser": "^5.46.0",
    "tsx": "^4.7.0",
    "typescript": "^5.0.2",
    "vite": "^4.3.2"
  }
}
